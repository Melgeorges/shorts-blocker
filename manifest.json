{
  "manifest_version": 3,
  "name": "Shorts Blocker",
  "version": "1.0",
  "description": "Limite le temps sur YouTube Shorts et Instagram à 30 min/jour",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shorts Blocker"
  }
}
